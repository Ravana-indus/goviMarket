# Gemini (aistudio.google.com/apikey). Without it a keyword demo parser reads simple text only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# memory for local runs, firestore on Cloud Run
STORE=memory
# 1 lets the console "Load demo morning" button wipe and reseed Firestore. Set 0 for real users.
ALLOW_RESET=1
# Console sign-in token and market agent PIN. Unset means that gate is open (fine locally only).
ADMIN_TOKEN=
AGENT_PIN=
# 0 only for plain-http local runs; Cloud Run is https so keep 1 there.
COOKIE_SECURE=0
RATE_LIMIT_PER_MIN=30
BUYER_DISCOUNT_SHARE=0.25
GOVI_FEE=0.05
# Phone sign-in. With Firebase (Authentication > Phone on) the browser sends real SMS codes.
# The web config apiKey is public, not a secret; deploy.sh reads it from the Firebase project.
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
# Demo numbers that sign in with a fixed code and no SMS. Unset: on when ALLOW_RESET=1.
# AUTH_DEMO_NUMBERS=0770000002,0770000014,0770000001
# AUTH_DEMO_CODE=123456
# Mobile numbers that may open the console after a phone sign-in (comma separated).
ADMIN_PHONES=
# Optional: real WhatsApp Cloud API. The /sim simulator works without these.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_DISPLAY_NUMBER=
